# Weaver LLM configuration (used as defaults)
# Copy this file to .env and update values.

# OpenAI-compatible Chat Completions endpoint
WEAVER_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Model name at your endpoint
WEAVER_LLM_MODEL=gpt-4o-mini

# Optional API key (leave empty for local endpoints that do not require auth)
WEAVER_LLM_API_KEY=

# Prompt used for image text extraction
WEAVER_LLM_SYSTEM_PROMPT=Extract all visible text from this image. Return plain text only.
